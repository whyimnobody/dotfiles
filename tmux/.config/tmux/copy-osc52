#!/bin/sh

set -eu

client_tty=${1:-}

# Only write to a Linux pseudoterminal belonging to the tmux client that
# initiated the copy. This keeps the destination from becoming shell input.
case "$client_tty" in
    /dev/pts/*) ;;
    *) exit 1 ;;
esac

tty_number=${client_tty#/dev/pts/}
case "$tty_number" in
    ''|*[!0-9]*) exit 1 ;;
esac

# Build the complete sequence before writing anything. copy-pipe-and-cancel
# redraws the client as it exits copy mode; writing the prefix early allows
# that redraw to split the OSC sequence and expose its base64 payload.
payload=$(base64 | tr -d '\n')
sleep 0.1
printf '\033]52;c;%s\007' "$payload" > "$client_tty"
