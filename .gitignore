.config/gnupg
.config/yarn
.gitconfig

**/node_modules
**/history
**/.zcompdump
**/.zsh_sessions

zsh/.config/zsh/.zcompcache

**/git/user*

# Runtime state that must not be folded into Stow packages
/terminal/.config/lnav/
/tmux/.config/tmux-sessionizer/state.yml
/tmux/.local/share/tmux/

# Stow-managed personal commands (overrides the global `bin/` ignore rule)
!/local-bin/
!/local-bin/.local/
!/local-bin/.local/bin/
!/local-bin/.local/bin/**

# Local credentials generated by the on-demand development service stack
/dev-services/.config/dev-services/.env
/graphify-out/cache
