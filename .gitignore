.config/gnupg
.config/yarn
.gitconfig

**/node_modules
**/history
**/.zcompdump
**/.zsh_sessions

zsh/.config/zsh/.zcompcache

**/git/user*

# Runtime state that must not be folded into Stow packages
/terminal/.config/lnav/
/tmux/.config/tmux-sessionizer/state.yml
/tmux/.local/share/tmux/

# Stow-managed personal commands (overrides the global `bin/` ignore rule)
!/local-bin/
!/local-bin/.local/
!/local-bin/.local/bin/
!/local-bin/.local/bin/**

# Local credentials generated by the on-demand development service stack
/dev-services/.config/dev-services/.env

# Regenerated by `graphify update .` (cache, graph.json, dated backups)
/graphify-out/

# Skill sync writes here because ~/.claude/skills points into this repo.
/llm/shared-skills/synced/

# Restored by `ya pkg install` from package.toml. folder-rules stays in git.
# video-preview is kept in git. ya pkg only deploys Lua, so preview.sh would
# be missing, and the pane-filling size change lives in main.lua.
/terminal/.config/yazi/plugins/*
!/terminal/.config/yazi/plugins/folder-rules.yazi/
!/terminal/.config/yazi/plugins/folder-rules.yazi/**
!/terminal/.config/yazi/plugins/video-preview.yazi/
/terminal/.config/yazi/plugins/video-preview.yazi/*
!/terminal/.config/yazi/plugins/video-preview.yazi/main.lua
!/terminal/.config/yazi/plugins/video-preview.yazi/preview.sh
