# OSC 52 from Mosh/tmux yanks on Asura. Ghostty defaults to allow writes, but
# a denied prompt or a Mac default of ask/deny drops the sequence silently.
clipboard-write = allow

theme = Catppuccin Mocha
font-family = "Cascadia Code"
font-family = "Symbols Nerd Font Mono"
font-size = 13

macos-option-as-alt = true
shell-integration-features = ssh-env,ssh-terminfo

quick-terminal-space-behavior = remain
window-inherit-working-directory = false
window-save-state = always
working-directory = home

keybind = global:§=toggle_quick_terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal

background-opacity = 0.9
cursor-opacity=0.35
keybind = shift+enter=text:\x1b\r
